# Copy to .env and fill in. NEVER commit .env
# On hosted platforms (Render, Railway, Vercel) set these in the dashboard instead.

# PORT is usually auto-assigned by the host; only set locally.
PORT=5000

# REQUIRED — MongoDB Atlas connection string. MONGODB_URI is also accepted.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/swachhsetu
# MONGODB_URI=

# REQUIRED — Long random string used to sign JWTs. The server will refuse to start without this in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Extra allowed frontend origins (comma-separated, no trailing slashes).
# localhost + https://swachh-setu-two.vercel.app + *.vercel.app are already allowed.
# Example: https://swachh-setu-two.vercel.app,https://your-custom-domain.com
CLIENT_ORIGIN=http://localhost:5173

# Optional: AI vision (WasteWise identify + report image verification).
# Without a key the app still works; AI features show "unavailable".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
