# Local only. Do NOT set this to localhost on Vercel — the production build
# would try to call the visitor's machine and every API request would fail.
# Local: leave as http://localhost:5000 or omit (Vite proxies /api to the backend).
# Vercel: set VITE_API_URL to your Render URL, e.g. https://swachhsetu-86ay.onrender.com
#         or leave it unset and use the /api rewrites in vercel.json.
VITE_API_URL=http://localhost:5000
